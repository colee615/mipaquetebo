{
  "expo": {
    "name": "TrackingBo App",
    "slug": "scannerapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#fed122"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1"
    },
    "android": {
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 2,
      "package": "bo.gob.correos.trackingboapp",
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#fed122"
      },
      "useNextNotificationsApi": true,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./movilrastreo1.png",
          "color": "#FECC36"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://trackingbo.correos.gob.bo",
      "enableUpdateCheck": true,
      "eas": {
        "projectId": "b88235af-ae91-4e4b-9dd2-40c9ff786c08"
      }
    },
    "owner": ""
  }
}
